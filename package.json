{
  "name": "velo-pos",
  "version": "1.46.2",
  "description": "Sistema POS desktop profesional para comercios, repuestos, sucursales y operaciones empresariales",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dev:pos": "electron . --dev",
    "dev:tech": "VELO_VERTICAL=tech electron . --dev --velo-root-data-dir=./data-tech",
    "rebuild": "electron-builder install-app-deps",
    "build": "electron-builder",
    "prepare:server-service": "node build/windows-service/prepare-winsw.js",
    "build:win:terminal": "electron-builder --config build/electron-builder-terminal.js --win",
    "build:win:server": "npm run prepare:server-service && electron-builder --config build/electron-builder-server.js --win",
    "build:win:tech": "electron-builder --config build/electron-builder-tech.js --win",
    "build:win:tech-server": "npm run prepare:server-service && electron-builder --config build/electron-builder-tech-server.js --win",
    "build:win": "npm run build:win:terminal && npm run build:win:tech && npm run build:win:server && npm run build:win:tech-server",
    "build:mac": "electron-builder --mac",
    "db:reset": "node scripts/resetDB.js",
    "release:win:terminal": "electron-builder --config build/electron-builder-terminal.js --win --publish always",
    "release:win:server": "npm run prepare:server-service && electron-builder --config build/electron-builder-server.js --win --publish always",
    "release:win:tech": "electron-builder --config build/electron-builder-tech.js --win --publish always",
    "release:win:tech-server": "npm run prepare:server-service && electron-builder --config build/electron-builder-tech-server.js --win --publish always",
    "release:win": "npm run release:win:terminal && npm run release:win:tech && npm run release:win:server && npm run release:win:tech-server",
    "release:mac": "electron-builder --mac --publish always",
    "verify-version": "node -e \"const v=require('./package.json').version; console.log('Version:',v); if(!v) process.exit(1)\"",
    "release": "npm run release:check && npm run build:win",
    "tag": "node scripts/createReleaseTag.js",
    "release:check": "node scripts/release-check.js",
    "verify:integrity": "node scripts/run-electron-node.js scripts/verify-historical-integrity.js",
    "verify:marker": "node scripts/check-historical-marker.js",
    "verify:packaging": "node scripts/check-packaging.js",
    "test:suite-invariants": "node scripts/test-suite-invariants.js",
    "test:suite-upgrade": "node scripts/run-electron-node.js scripts/test-suite-upgrade-safety.js",
    "test:import": "node scripts/run-electron-node.js scripts/test-import-hardening.js",
    "test:all-in-one": "node scripts/run-electron-node.js scripts/test-equiparts-all-in-one.js",
    "test:all-in-one-integration": "node scripts/run-electron-node.js scripts/test-equiparts-import-integration.js",
    "test:financial": "node scripts/run-electron-node.js scripts/test-financial-core.js",
    "test:business": "node scripts/run-electron-node.js scripts/test-multi-business-detached-db.js",
    "test:url": "node scripts/test-url-safe.js",
    "test:input-normalization": "node scripts/test-input-normalization.js",
    "test:user-permissions": "node scripts/run-electron-node.js scripts/test-user-operational-permissions.js",
    "test:login": "node scripts/test-login-rate.js",
    "test:pos": "node scripts/test-pos-interactions.js",
    "test:checkout": "node scripts/run-electron-node.js scripts/test-checkout-orders.js",
    "test:customer-companies": "node scripts/run-electron-node.js scripts/test-customer-companies.js",
    "test:printing": "node scripts/test-printer-profiles.js",
    "test:pending-invoices": "node scripts/run-electron-node.js scripts/test-pending-invoices.js",
    "test:salespeople": "node scripts/run-electron-node.js scripts/test-salespeople.js",
    "test:documents": "node scripts/run-electron-node.js scripts/test-document-workflows.js",
    "test:sales-workflow": "node scripts/run-electron-node.js scripts/test-sales-workflow-enhancements.js",
    "test:sale-corrections": "node scripts/run-electron-node.js scripts/test-sale-corrections.js",
    "test:crm": "node scripts/run-electron-node.js scripts/test-crm-cerebro.js",
    "test:product-units": "node scripts/run-electron-node.js scripts/test-product-units.js",
    "test:service-orders": "node scripts/run-electron-node.js scripts/test-service-orders.js",
    "test:tech-premium": "node scripts/run-electron-node.js scripts/test-tech-premium-operations.js",
    "test:tech-readiness": "npm run release:check && npm run test:suite-invariants && npm run test:product-units && npm run test:service-orders && npm run test:service-portal && npm run test:trade-in-warranty && npm run test:suite-license && npm run test:server-service && npm run test:tech-premium",
    "test:service-portal": "node scripts/run-electron-node.js scripts/test-service-customer-portal.js",
    "test:trade-in-warranty": "node scripts/run-electron-node.js scripts/test-trade-in-warranty.js",
    "test:suite-license": "node scripts/test-suite-license-products.js && node scripts/test-provider-license-manager.js",
    "test:serialized-sale": "node scripts/run-electron-node.js scripts/test-serialized-sale.js",
    "test:server-service": "node scripts/test-server-service.js",
    "test:experience": "node scripts/test-experience-system.js",
    "test:payment-ui": "node scripts/test-payment-ui-resilience.js",
    "test:cash-ui": "node scripts/test-cash-ui-resilience.js",
    "test:system-doctor": "node scripts/run-electron-node.js scripts/test-system-doctor-financial.js",
    "test:ncf": "node scripts/run-electron-node.js scripts/test-ncf-sequences.js",
    "test:data-loader": "node scripts/test-data-loader-resilience.js",
    "test": "npm run test:url && npm run test:input-normalization && npm run test:user-permissions && npm run test:login && npm run test:pos && npm run test:data-loader && npm run test:checkout && npm run test:customer-companies && npm run test:business && npm run test:import && npm run test:all-in-one && npm run test:all-in-one-integration && npm run test:financial && npm run test:payment-ui && npm run test:cash-ui && npm run test:printing && npm run test:pending-invoices && npm run test:salespeople && npm run test:documents && npm run test:sales-workflow && npm run test:sale-corrections && npm run test:system-doctor && npm run test:ncf && npm run test:server-service && npm run test:experience && npm run test:product-units && npm run test:serialized-sale && npm run test:service-orders && npm run test:service-portal && npm run test:trade-in-warranty && npm run test:suite-license"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.11.1",
    "electron-updater": "^6.8.3",
    "qrcode-generator": "^1.5.2"
  },
  "devDependencies": {
    "electron": "^41.7.1",
    "electron-builder": "^26.15.3",
    "jsbarcode": "^3.12.3"
  },
  "overrides": {
    "js-yaml": "^4.3.0",
    "glob@7.2.3": {
      "minimatch": {
        "brace-expansion": "1.1.16"
      }
    }
  },
  "build": {
    "appId": "do.velopos.app",
    "productName": "Velo POS",
    "copyright": "Copyright 2026 — Velo POS",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "lib/**/*",
      "main.js",
      "preload.js",
      "database.js",
      "versioning.js",
      "logger.js",
      "license.js",
      "!**/.DS_Store",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/*.d.ts",
      "!**/node_modules/.bin",
      "!dist/**",
      "!data/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "src/assets/icon.png",
      "category": "public.app-category.business",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Velo POS",
      "installerIcon": "src/assets/icon.ico",
      "uninstallerIcon": "src/assets/icon.ico",
      "installerHeaderIcon": "src/assets/icon.ico",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "publish": {
      "provider": "github",
      "owner": "dobleumediado-oss",
      "repo": "velo-pos",
      "releaseType": "release"
    }
  }
}
